---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getCurrentLocale } from '../i18n/i18n'
import { BASE_PATH } from '../utils/basePath'

/**
 * DefaultLayout
 *
 * Root layout wrapping every page. Provides:
 * - <html lang> set from the current locale for screen readers
 * - <head> with charset, viewport, CSP, preloaded font, and SEO meta
 * - Sticky footer via CSS grid (header auto | main 1fr | footer auto)
 * - SkipLink component lives inside Header.astro (accessible-astro-components)
 *
 * Accessibility:
 * - lang attribute enables correct pronunciation by screen readers
 * - <main id="main-content"> is the skip-link target (WCAG 2.4.1)
 * - Semantic landmark flow: <header> → <main> → <footer>
 *
 * Performance:
 * - Font preloaded for fast first paint (Atkinson Hyperlegible — high readability)
 * - Meta description auto-truncated to 155 chars for SEO
 *
 * @see WCAG 2.4.1 — Bypass Blocks
 * @see WCAG 3.1.1 — Language of Page
 */

const {
  title = 'KidCy',
  description = 'Dive into our learning modules designed to teach you about digital citizenship, authentication, data privacy, social engineering, malware, and digital abuse.',
  url = Astro.url.toString(),
  image = '/WWW-preview.png',
  author = 'KidCy Team',
} = Astro.props

const cleanDescription = description.trim()
const metaDescription =
  cleanDescription.length > 155 ? `${cleanDescription.slice(0, 152).trimEnd()}...` : cleanDescription
const currentLocale = getCurrentLocale(Astro.currentLocale)
---

<html lang={currentLocale} dir="ltr">
  <head>
    <!-- Browser language detection — runs before paint to avoid redirect flash.
         Auto-redirects once on first visit; manual switcher clicks override the preference. -->
    <script is:inline define:vars={{ basePath: BASE_PATH }}>
      ;(function () {
        var SUPPORTED = ['cs', 'de', 'lt', 'no']
        var STORAGE_KEY = 'kidcy-locale-pref'
        try {
          // Path without the site base (e.g. /kidcy) so the locale is the first segment
          var path = window.location.pathname
          if (basePath && (path === basePath || path.indexOf(basePath + '/') === 0)) {
            path = path.slice(basePath.length) || '/'
          }
          var firstSegment = path.split('/').filter(Boolean)[0] || ''
          var onLocalizedPage = SUPPORTED.indexOf(firstSegment) !== -1

          // Landing on a locale-prefixed page — persist it as the preference
          if (onLocalizedPage) {
            localStorage.setItem(STORAGE_KEY, firstSegment)
            return
          }

          // On English path — check stored preference
          var stored = localStorage.getItem(STORAGE_KEY)
          if (stored !== null) {
            if (SUPPORTED.indexOf(stored) !== -1) {
              window.location.replace(basePath + '/' + stored + path + window.location.search + window.location.hash)
            }
            return
          }

          // No preference yet — detect from browser
          var langs = [].slice.call(navigator.languages || (navigator.language ? [navigator.language] : ['en']))
          var detected = 'en'
          for (var i = 0; i < langs.length; i++) {
            var base = langs[i].toLowerCase().split('-')[0]
            if (base === 'nb' || base === 'nn') base = 'no'
            if (SUPPORTED.indexOf(base) !== -1) {
              detected = base
              break
            }
          }

          localStorage.setItem(STORAGE_KEY, detected)
          if (detected !== 'en') {
            window.location.replace(basePath + '/' + detected + path + window.location.search + window.location.hash)
          }
        } catch (_) {}
      })()
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/WWW-icon.svg" />

    <!-- Preload primary font for fast first contentful paint -->
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <SiteMeta title={title} description={metaDescription} url={url} image={image} author={author} />
  </head>
  <body class="site-shell">
    <Header />
    <main id="main-content" class="site-main" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <style lang="scss" is:global>
      /* ── Sticky footer via CSS grid ── */
      html {
        block-size: 100%;
      }

      body {
        min-block-size: 100%;     /* fallback for browsers without dvh support */
        min-block-size: 100dvh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        overflow-x: clip;
        background-color: var(--background-color);
      }

      .site-main {
        inline-size: 100%;
        padding-block-end: max(var(--space-s), env(safe-area-inset-bottom));
      }

      /* Fallback for browsers that don't support overflow: clip */
      @supports not (overflow: clip) {
        body {
          overflow-x: hidden;
        }
      }

      @media (max-width: 48rem) {
        .site-main {
          padding-block-end: max(var(--space-xs), env(safe-area-inset-bottom));
        }
      }

      /* Scrollable code blocks — role="region" added via JS would be ideal,
         but tabindex="0" is handled by browsers for overflow content */
      pre {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-inline-size: 100%;
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      /* Respect reduced motion preference globally */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
